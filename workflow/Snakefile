"""Population genomics workflow: filtered VCF -> ancestry -> per-population statistics.

Pipeline:
  prepare     annotate IDs, attach coordinates, drop samples, LD-prune, subsample
  structure   PCA, ADMIXTURE, TESS (optional), composite figure
  populations assign populations, sex-linked scaffold QC, ROH/F_ROH, pi, GONE
  clam        callable-site-aware pi / dxy / Fst / ROH-corrected heterozygosity

The input is a filtered, biallelic SNP VCF — snpArcher's _clean_snps.vcf.gz or
anything equivalent. Site filtering (depth, missingness, MAF, callable regions)
belongs to the variant caller and is deliberately not repeated here.

Expected inputs, relative to the working directory (--directory):
  results/{refgenome}/{prefix}_clean_snps.vcf.gz   required
  results/{refgenome}/data/genome/{refgenome}.fna.fai
  a coordinate sheet (use_coords: true) and a GVCF directory (run_clam: true)
  a callable-sites BED (optional; the pi / heterozygosity denominator)

See README.md for the full description and config/config.yaml for every knob.
"""

import os

from snakemake.utils import min_version

min_version("7.32")


# Keep numeric wildcards numeric. Without this, population/K/seed wildcards can
# absorb path fragments and make rules ambiguous.
wildcard_constraints:
    refGenome=r"[^/]+",
    k=r"\d+",
    K=r"\d+",
    seed=r"\d+",


include: "rules/common.smk"
include: "rules/prepare.smk"
include: "rules/structure.smk"
include: "rules/populations.smk"
include: "rules/clam.smk"


rule all:
    input:
        workflow_targets(),
