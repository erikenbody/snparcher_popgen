"""Population genomics workflow: filtered VCF -> ancestry -> per-population statistics.

Pipeline:
  prepare     annotate IDs, attach coordinates, drop samples, LD-prune, subsample
  structure   PCA, ADMIXTURE, TESS (optional), composite figure
  populations assign populations, sex-linked scaffold QC, ROH/F_ROH, pi
  ne          GONE2 recent Ne + currentNe2 contemporary Ne     [run_ne]
  clam        callable-site-aware pi / dxy / Fst / ROH-corrected het  [run_clam]
  trackhub    UCSC track hub                                    [run_trackhub]

The input is a filtered, biallelic SNP VCF — snpArcher's clean_snps.vcf.gz or
anything equivalent — named by `vcf` in the config. Site filtering (depth,
missingness, MAF, callable regions) belongs to the variant caller and is
deliberately not repeated here.

Inputs (config keys):
  vcf                  required
  fai                  optional; contig lengths come from the VCF header otherwise
  coords_sheet         when use_coords is true
  callable_sites_bed   optional; the pi / heterozygosity denominator
  gvcf_dir             when run_clam is true

Runs standalone (snakemake --directory <project> --configfile <config>) or as a
snpArcher module, which passes these paths in. See README.md and
config/config.yaml for every option.
"""

import os

from snakemake.utils import min_version

min_version("7.32")


# Keep numeric wildcards numeric. Without this, population/K/seed wildcards can
# absorb path fragments and make rules ambiguous.
wildcard_constraints:
    k=r"\d+",
    K=r"\d+",
    seed=r"\d+",


include: "rules/common.smk"
include: "rules/prepare.smk"
include: "rules/structure.smk"
include: "rules/populations.smk"


if RUN_NE:

    include: "rules/ne.smk"


if RUN_CLAM:

    include: "rules/clam.smk"


if RUN_TRACKHUB:

    include: "rules/trackhub.smk"


rule all:
    default_target: True
    input:
        workflow_targets(),
